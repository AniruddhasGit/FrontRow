# =====================================================================================================
# FrontRow - every environment variable the API, the worker and the seed read (SRC-002 §7.1, §13.4;
# PRD S7.9). This file must list exactly the names app/core/config.py declares (S-XCT-29 checks it).
#
# PLACEHOLDERS ONLY. No real value and no credential ever goes in this file; it is committed.
#   - Locally: docker-compose.yml already sets working local values. Copy this file to `.env`
#     (git-ignored) only if you run the API outside compose.
#   - In AWS: the ECS task definition sets these. Which are SecureString parameters and which are plain
#     environment entries: docs/30 Deployment/P1_SSM_PARAMETERS.md.
#
# The application reads ONLY environment variables - it never reads this file itself.
# A missing or invalid value makes the API EXIT 78 at boot, with one JSON line naming the variable.
# =====================================================================================================

# ---- REQUIRED. No default, on purpose: a guessed value produces a container that starts, connects
# ---- to nothing and reports healthy.

# PostgreSQL connection string, as the APPLICATION user (frontrow_app), never the owner. SECRET: SecureString.
# Must start with postgresql:// or postgres://. Wrong host: /health/ready is 503 "postgres: unreachable".
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/frontrow

# Redis for locks, cache and rate-limit buckets. SECRET if the node has an auth token. redis:// or rediss://.
# Wrong host: /health/ready is 503 "redis: unreachable", and from Phase 4 every seat hold returns 503.
REDIS_URL=redis://CHANGE_ME_HOST:6379/0

# SQS queue URL in AWS, ElasticMQ locally. Wrong: receipts accumulate in the outbox and never leave.
QUEUE_URL=http://CHANGE_ME_HOST:9324/000000000000/frontrow-receipts

# Signs the session token. SECRET: SecureString. A default would be a forged session for anyone who
# reads the source. Rotating it signs every customer out.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SIGNING_KEY

# The payment provider. The ONLY permitted value is simulated; anything else exits 78 at boot.
PAYMENT_PROVIDER=simulated

# The mail transport: exactly ses, resend or stub. stub writes the message to stdout and sends nothing (local
# only); resend is the Render copy's HTTPS transport (SRC-005 D-2); ses is the AWS deployment's.
# A deployment left on stub silently sends no receipts.
MAIL_PROVIDER=stub

# The Resend API key. Read ONLY when MAIL_PROVIDER=resend (the Render copy), where the process refuses to start
# without it. A secret: never in a file, never logged. Leave it empty everywhere else.
RESEND_SECRET=

# The private bucket holding posters. Wrong: poster upload fails (Phase 6).
S3_BUCKET_NAME=CHANGE_ME_POSTER_BUCKET

# Region for the S3, SQS and SES clients. Wrong: every AWS call goes to a region with none of them.
AWS_REGION=CHANGE_ME_REGION

# The SES-verified sender identity for receipts. Wrong: SES rejects every receipt, and the customer who
# paid cannot enter the hall. Must be non-empty when MAIL_PROVIDER=ses.
SES_SENDER_ADDRESS=receipts@example.invalid

# The address used in emailed links; http:// or https://. Wrong: the link in a receipt goes nowhere.
PUBLIC_BASE_URL=http://CHANGE_ME_HOST

# The session cookie's Secure flag. NO DEFAULT (OPEN-TLS-01 is deferred). true requires PUBLIC_BASE_URL to
# begin https://, or the browser never sends the cookie back and nobody stays signed in.
COOKIE_SECURE=false

# The one trusted proxy range for X-Forwarded-For (the load balancer's subnets). * is refused at boot:
# trusting any peer is trusting the client, and the rate limiter then protects nothing.
FORWARDED_ALLOW_IPS=CHANGE_ME_LOAD_BALANCER_SUBNET_CIDR

# Idempotency-Key prefix that makes the simulated payment fail on purpose. 1-32 characters. Pick one no
# ordinary customer could send by accident.
PAYMENT_SIMULATOR_FAIL_KEY_PREFIX=CHANGE_ME_FAIL_PREFIX-

# ---- OPTIONAL. The default IS the ruled value (PRD S7.9); set one only to change it deliberately.

# The seat hold, ruled at 3 minutes. Too long holds seats off sale; too short and customers cannot finish.
SEAT_HOLD_TTL_SECONDS=180

# Seats per booking, 1-10. Above 10 contradicts the ruling and exits 78; below is stricter and allowed.
MAX_SEATS_PER_BOOKING=10

# Signed minutes from the advertised start when sales close (PROVISIONAL: +15 means after the start).
SALES_CUTOFF_MINUTES=15

# The ruled currency.
CURRENCY_CODE=INR

# Paise per rupee. A ONE-WAY DOOR: changing it rewrites what every past customer paid. Must be 100 for INR.
CURRENCY_MINOR_UNIT_RATIO=100

# The zone every human-read time is rendered in. Must resolve in the time zone database.
CINEMA_TIMEZONE=Asia/Kolkata

# Seat-map cache lifetime. Cache TTL + poll interval must be at most 15.
SEATMAP_CACHE_TTL_SECONDS=10

# Movie and showtime list cache lifetime. Longer: an admin's publish takes longer to appear.
LISTING_CACHE_TTL_SECONDS=60

# How often the browser re-reads the seat map.
SEATMAP_POLL_INTERVAL_SECONDS=3

# The per-key cache stampede guard.
CACHE_REBUILD_LOCK_TTL_MS=2000

# The simulated payment's delay. Must stay under SEAT_HOLD_TTL_SECONDS x 1000 x 0.1, or exits 78.
PAYMENT_SIMULATED_DELAY_MS=1500

# Redis connect timeout. Without it an unreachable node hangs requests instead of returning 503.
REDIS_CONNECT_TIMEOUT_MS=500

# Redis per-command timeout. Without it a node that accepts and never answers hangs the request.
REDIS_COMMAND_TIMEOUT_MS=500

# How long in-flight requests get after SIGTERM. The ECS stop timeout must exceed it, or SIGKILL lands mid-drain.
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=20

# How long one /health/ready result is reused. Keep it under the load balancer's unhealthy window. 0 = every poll.
READINESS_CACHE_TTL_SECONDS=3

# DEBUG | INFO | WARNING | ERROR. Never DEBUG in a deployed environment: it burns the 5 GB CloudWatch allowance.
LOG_LEVEL=INFO

# Connections held per process. db.t3.micro has roughly 110 in total, multiplied across processes.
DB_POOL_SIZE=5

# Burst connections above the pool. Same ceiling.
DB_POOL_MAX_OVERFLOW=2

# Server-side ceiling on one SQL statement (ASSUMED). Absent, one slow query can hold the pool.
DB_STATEMENT_TIMEOUT_MS=5000

# Ceiling on connecting to PostgreSQL. ASSUMED: no frozen source names it.
DB_CONNECT_TIMEOUT_MS=1000

# Worker long-poll wait, 0-20. Short polling burns the SQS free-tier allowance on empty receives.
QUEUE_POLL_WAIT_SECONDS=20

# Ceiling on one SendMessage inside a customer's confirm request (ASSUMED).
QUEUE_SEND_TIMEOUT_MS=2000

# Ceiling on one SendEmail in the worker (ASSUMED).
SES_SEND_TIMEOUT_MS=5000

# Outbox rows the worker relays per loop.
OUTBOX_RELAY_BATCH_SIZE=20

# How old a pending outbox row must be before the relay claims it.
OUTBOX_RELAY_MIN_AGE_SECONDS=30

# When a receipt send claim counts as abandoned. Must exceed OUTBOX_RELAY_MIN_AGE_SECONDS.
RECEIPT_CLAIM_STALE_SECONDS=900

# Poster upload ceiling in bytes.
POSTER_MAX_BYTES=2097152

# Presigned poster URL lifetime. Must exceed POSTER_REDIRECT_CACHE_SECONDS.
PRESIGNED_URL_TTL_SECONDS=3600

# Password length floor, in characters.
PASSWORD_MIN_LENGTH=12

# Session lifetime (12 hours).
SESSION_TTL_SECONDS=43200

# Single-use password-reset token lifetime (30 minutes).
PASSWORD_RESET_TTL_SECONDS=1800

# The stress script's self-concurrency threshold.
STRESS_CONCURRENCY_SPREAD_MS=100

# How many bcrypt hashes run at once (ASSUMED: the t3.micro's vCPU count).
BCRYPT_THREAD_POOL_SIZE=2

# How long one hash may take, including its wait for a pool slot (ASSUMED).
BCRYPT_HASH_TIMEOUT_MS=5000

# bcrypt work factor.
BCRYPT_COST=12

# Cache-Control max-age on the poster redirect (ASSUMED). Must stay under PRESIGNED_URL_TTL_SECONDS.
POSTER_REDIRECT_CACHE_SECONDS=300

# The port the API binds in the container, 1024-65535. The target group, security group and port mapping
# must all use this number. Below 1024 the non-root process cannot bind it and exits 78.
API_PORT=8000

# The port the worker's /metrics listener binds, 1024-65535, never equal to API_PORT.
WORKER_METRICS_PORT=8001

# Minimum gap between two receipt resends for one booking (ASSUMED).
RECEIPT_RESEND_MIN_INTERVAL_SECONDS=300

# Seat holds per user per minute. Every rate-limit number is an estimate, replaced by the Phase 7 load test.
RATE_LIMIT_HOLD_USER_PER_MIN=20

# Seat holds per IP per minute.
RATE_LIMIT_HOLD_IP_PER_MIN=60

# Booking confirmations per user per minute.
RATE_LIMIT_CONFIRM_USER_PER_MIN=10

# Booking confirmations per IP per minute.
RATE_LIMIT_CONFIRM_IP_PER_MIN=30

# Sign-in attempts per email per 15 minutes.
RATE_LIMIT_LOGIN_USER_PER_15MIN=10

# Sign-in attempts per IP per 15 minutes.
RATE_LIMIT_LOGIN_IP_PER_15MIN=30

# Registrations per IP per hour.
RATE_LIMIT_REGISTER_IP_PER_HOUR=5

# Password-reset requests per IP per hour.
RATE_LIMIT_RESET_IP_PER_HOUR=5

# Password-reset confirmations per IP per hour.
RATE_LIMIT_RESET_CONFIRM_IP_PER_HOUR=10

# Booking-reference lookups per user per minute.
RATE_LIMIT_LOOKUP_USER_PER_MIN=20

# Booking-reference lookups per IP per minute.
RATE_LIMIT_LOOKUP_IP_PER_MIN=60

# Seat-map reads per IP per minute.
RATE_LIMIT_SEATMAP_IP_PER_MIN=120

# Dashboard report requests per user per minute.
REPORTS_RATE_LIMIT_PER_USER_PER_MINUTE=60

# ---- SEED ONLY (scripts/seed.py, Phase 2). The API and the worker never read these.

# The one password on every seeded account. SECRET. Required by the seed and by nothing else. This
# placeholder is refused by value: the seed exits before writing anything if it is left as is.
SEED_DEFAULT_PASSWORD=CHANGE_ME_NOT_A_REAL_PASSWORD

# Minutes added to a seeded film's runtime for showtime.ends_at (ASSUMED), 0-50.
SEED_CHANGEOVER_MINUTES=20

# The domain every seeded address sits at. .invalid can never receive mail; a real domain here bounces
# seeded receipts against the SES sending reputation.
SEED_EMAIL_DOMAIN=demo.frontrow.invalid
