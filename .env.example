# =====================================================================================================
# FrontRow API - every environment variable Phase 1 reads (SRC-002 §7.1, §13.4; PRD S7.9).
#
# PLACEHOLDERS ONLY. No real value and no credential ever goes in this file; it is committed.
#   - Locally: docker-compose.yml already sets working local values. Copy this file to `.env`
#     (git-ignored) only if you run the API outside compose.
#   - In AWS: the ECS task definition sets these. Secrets come from SSM Parameter Store as SecureString
#     parameters named /frontrow/<environment>/<VARIABLE_NAME> (docs/30 Deployment/P1_SSM_PARAMETERS.md).
#
# The application reads ONLY environment variables - it never reads this file itself.
# A missing or invalid value makes the API EXIT 78 at boot, with one JSON line naming the variable.
#
# Phase 1 only. Variables for later phases (JWT_SECRET, QUEUE_URL, PAYMENT_PROVIDER, MAIL_PROVIDER,
# SEAT_HOLD_TTL_SECONDS, ...) are added here in the phase that first reads them; the full inventory is
# docs/03 PRD/ S7.9.
# =====================================================================================================

# ---- REQUIRED. No default, on purpose: a guessed value produces a container that starts, connects
# ---- to nothing and reports healthy.

# PostgreSQL connection string. SECRET (it carries the password) -> SSM SecureString in AWS.
# Must start with postgresql:// or postgres://. Wrong host: /health/ready is 503 "postgres: unreachable".
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/frontrow

# Redis connection string. SECRET if the node has an auth token. redis:// or rediss:// (TLS).
# Wrong host: /health/ready is 503 "redis: unreachable".
REDIS_URL=redis://CHANGE_ME_HOST:6379/0

# ---- OPTIONAL. The default IS the ruled value (PRD S7.9); set only to change it deliberately.

# DEBUG | INFO | WARNING | ERROR. DEBUG in a deployed environment burns the 5 GB CloudWatch free tier.
LOG_LEVEL=INFO

# The port the API binds inside the container. Must be >= 1024: the process is not root and cannot
# bind a privileged port. The target group, security group and port mapping must all use this number.
API_PORT=8000

# How long in-flight requests get to finish after SIGTERM. Must be shorter than
# (ECS stop timeout - target group deregistration delay), or SIGKILL lands mid-drain.
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=20

# How long one /health/ready result is reused. Must be shorter than the load balancer's
# (unhealthy threshold x interval), or the load balancer acts on stale answers. 0 = probe every poll.
READINESS_CACHE_TTL_SECONDS=3

# Ceiling on connecting to PostgreSQL for the readiness probe. Without it an unreachable database
# hangs the probe instead of failing fast. ASSUMED value: no frozen source names it.
DB_CONNECT_TIMEOUT_MS=1000

# Redis connect and per-command timeouts. Without them an unreachable node hangs requests instead of
# returning 503, and hung requests exhaust the connection pool.
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_COMMAND_TIMEOUT_MS=500
